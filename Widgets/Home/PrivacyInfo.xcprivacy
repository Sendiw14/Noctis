<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widgets read one small file from the App Group and draw it. They track nothing, collect nothing and call no
	     required-reason API: no UserDefaults, no file timestamps, no boot time, no disk space, no keyboards. PrivacyManifestTests
	     scans the extension's code and the kit it links for every category, and fails if one appears and is not listed here. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
