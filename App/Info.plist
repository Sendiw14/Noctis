<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What the system shows under its own question about alarms. AlarmKit refuses to schedule
	     without it. Xcode has no build setting for this key, so it lives here and is merged
	     with the Info.plist Xcode generates for everything else (project.yml). -->
	<!-- Sleep sounds keep playing with the screen locked: the app plays audio, and only when the
	     person has started a sound (R31). -->
	<!-- The one URL scheme: widgets open the app with noctis://recovery, sleep, tonight, wind-down or bedtime, and nothing
	     else is accepted (WidgetURLRouter, APP_RULES.md R44). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.noctis.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>noctis</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSAlarmKitUsageDescription</key>
	<string>NOCTIS uses an alarm to wake you at the time you set. It can sound and appear on screen even when a Focus is on.</string>
</dict>
</plist>
