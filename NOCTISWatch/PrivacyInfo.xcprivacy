<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This Watch target keeps the summary the iPhone sends it in files in its own App Group, and shows it. It tracks nothing and collects nothing.
	     Its one required-reason API is UserDefaults, for one preference of its own (whether breathing plays haptics), read and written by the
	     Watch app itself and shared with nothing (CA92.1). No file timestamps, no boot time, no disk space, no keyboards. The tests scan its code and
	     the kits it links for every category, and fail if one appears and is not listed here. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
