+++ b/Packages/NoctisKit/Tests/NoctisKitTests/SchemaFingerprintTests.swift
@@ -0,0 +1,49 @@
+import Foundation
+import SwiftData
+import Testing
+
+@testable import CoachKit
+@testable import JournalKit
+@testable import NoctisCore
+
+// A change to a stored model without a new schema version is the one way an update can damage or lose someone's data (X-16, S1B-B01). The shape of each shipped version
+// is written down here; a model that no longer matches fails this test until a version and a migration stage are added (Docs/MIGRATION_PROCEDURE.md) and the line
+// below is updated with them. There is no second version and none is made up to exercise the machinery: the migration harness has its own tests with a synthetic one.
+
+private func fingerprint(_ schema: any VersionedSchema.Type) -> String {
+    Schema(versionedSchema: schema).entities
+        .sorted { $0.name < $1.name }
+        .map { entity in
+            let attributes = entity.attributes.sorted { $0.name < $1.name }.map { "\($0.name):\($0.valueType)" }.joined(separator: ",")
+            let relationships = entity.relationships.sorted { $0.name < $1.name }.map { "\($0.name)->\($0.destination)" }.joined(separator: ",")
+            return "\(entity.name){\(attributes)|\(relationships)}"
+        }
+        .joined(separator: ";")
+}
+
+struct SchemaFingerprintTests {
+    private static let message =
+        "A stored model changed. Do not edit this line to make the test pass: add a VersionedSchema, a migration stage and an upgrade test first (Docs/MIGRATION_PROCEDURE.md)."
+
+    @Test func theAppDatabaseIsVersion1AsShipped() {
+        #expect(fingerprint(NoctisSchemaV1.self) == "AlarmConfiguration{alarmKitID:Optional<UUID>,lastStateRaw:String,minutesSinceMidnight:Int,repeatDaysRaw:Array<Int>,snoozeEnabled:Bool,snoozeMinutes:Int,updatedAt:Date|};UserProfileRecord{createdAt:Date,healthAuthorizationRequested:Bool,name:String,onboardingComplete:Bool,primaryGoalRaw:String,secondaryGoalRaw:Optional<String>,sleepGoalHours:Double,typicalWakeMinutes:Int|};WindDownSession{completed:Bool,id:UUID,plannedMinutes:Int,start:Date|}", Comment(rawValue: Self.message + " Now: " + fingerprint(NoctisSchemaV1.self)))
+    }
+
+    @Test func coachHistoryIsVersion1AsShipped() {
+        #expect(fingerprint(CoachHistorySchemaV1.self) == "AIConversation{createdAt:Date,id:UUID,updatedAt:Date|messages->AIMessage};AIMessage{answerData:Data,answerSummary:String,createdAt:Date,feedbackRaw:Optional<String>,id:UUID,question:String|conversation->AIConversation}", Comment(rawValue: Self.message + " Now: " + fingerprint(CoachHistorySchemaV1.self)))
+    }
+
+    @Test func theJournalIsVersion1AsShipped() {
+        #expect(fingerprint(JournalSchemaV1.self) == "JournalEntry{date:Date,energy:Optional<Int>,focus:Optional<Int>,id:UUID,mood:Optional<Int>,text:String|}", Comment(rawValue: Self.message + " Now: " + fingerprint(JournalSchemaV1.self)))
+    }
+
+    @Test func everyStoredModelBelongsToAVersionedSchemaThisTestKnows() throws {
+        // A fourth SwiftData store would need a fingerprint here: any `@Model` outside the three is a failure of this list, not of the model.
+        let files = RawDefaultsTests.swiftFiles(under: ["Packages/NoctisKit/Sources"])
+        let models = files.filter { RawDefaultsTests.code($0.text).contains("@Model") }.map(\.path)
+        let known = ["NoctisSchema", "CoachHistory", "JournalStore", "AppModels", "WindDownSession", "UserProfile", "AlarmConfiguration", "AIConversation", "JournalEntry"]
+        for path in models {
+            #expect(known.contains { path.contains($0) }, Comment(rawValue: "\(path) declares a @Model that no fingerprint above covers"))
+        }
+    }
+}
diff --git a/Packages/NoctisKit/Tests/NoctisKitTests/StoreCompactionRealStoreTests.swift b/Packages/NoctisKit/Tests/NoctisKitTests/StoreCompactionRealStoreTests.swift
new file mode 100644
index 0000000..f19fc15
--- /dev/null
+++ b/Packages/NoctisKit/Tests/NoctisKitTests/StoreCompactionRealStoreTests.swift
@@ -0,0 +1,248 @@
+import Foundation
+import SQLite3
+import SwiftData
+import Testing
+
+@testable import CoachKit
+@testable import JournalKit
+@testable import NoctisCore
+
+// Compaction against the stores NOCTIS really writes (S1B-R-05, R-04): insert, delete, compact, reopen through the real container, read every kept row, and check
+// that nothing about the file's protection or backup exclusion changed. The temporary-file evidence for `temp_store = MEMORY` is measured here too.
+
+private nonisolated func folder() throws -> URL {
+    let url = URL.temporaryDirectory.appending(path: "noctis-realcompact-\(UUID().uuidString)", directoryHint: .isDirectory)
+    try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+    return url
+}
+
+private nonisolated func size(_ url: URL) -> Int { (try? FileManager.default.attributesOfItem(atPath: url.path)[.size] as? Int) ?? 0 }
+
+/// What the file and its folder say about protection and backup.
+private nonisolated struct FileFacts: Equatable {
+    var protection: String
+    var folderProtection: String
+    var excluded: Bool
+    var folderExcluded: Bool
+
+    init(_ file: URL) {
+        func protection(_ url: URL) -> String {
+            ((try? FileManager.default.attributesOfItem(atPath: url.path)[.protectionKey]) as? FileProtectionType)?.rawValue ?? "none"
+        }
+        func excluded(_ url: URL) -> Bool { (try? url.resourceValues(forKeys: [.isExcludedFromBackupKey]).isExcludedFromBackup) ?? false }
+        self.protection = protection(file)
+        self.folderProtection = protection(file.deletingLastPathComponent())
+        self.excluded = excluded(file)
+        self.folderExcluded = excluded(file.deletingLastPathComponent())
+    }
+}
+
+private nonisolated final class Outcomes: @unchecked Sendable {
+    private let lock = NSLock()
+    private var values: [StoreOpenOutcome] = []
+    func add(_ value: StoreOpenOutcome) { lock.withLock { values.append(value) } }
+    var all: [StoreOpenOutcome] { lock.withLock { values } }
+}
+
+private nonisolated func recovery(_ folder: URL, _ outcomes: Outcomes) -> StoreRecovery {
+    StoreRecovery(quarantineRoot: folder.appending(path: "Quarantine"), report: { _, outcome in outcomes.add(outcome) })
+}
+
+private nonisolated func millis(_ work: () -> Void) -> Double {
+    let start = ContinuousClock.now
+    work()
+    let elapsed = ContinuousClock.now - start
+    return Double(elapsed.components.seconds) * 1000 + Double(elapsed.components.attoseconds) / 1e15
+}
+
+struct StoreCompactionRealStoreTests {
+    @Test func theJournalIsCompactedAndEveryKeptEntryIsStillThere() throws {
+        let dir = try folder()
+        defer { try? FileManager.default.removeItem(at: dir) }
+        let url = dir.appending(path: "journal.store")
+        let outcomes = Outcomes()
+        var kept: [String] = []
+        do {
+            let container = try JournalContainer.make(directory: dir, recovery: recovery(dir, outcomes))
+            let context = ModelContext(container)
+            for index in 0..<3000 {
+                let entry = JournalEntry()
+                entry.text = "\(index) " + String(repeating: "note ", count: 400)
+                entry.mood = index % 5 + 1
+                context.insert(entry)
+            }
+            try context.save()
+            for entry in try context.fetch(FetchDescriptor<JournalEntry>()) {
+                if (Int(entry.text.prefix(while: { $0 != " " })) ?? 1) % 10 == 0 {
+                    kept.append(entry.text)
+                } else {
+                    context.delete(entry)
+                }
+            }
+            try context.save()
+        }
+        let before = FileFacts(url)
+        let bytesBefore = size(url) + size(dir.appending(path: "journal.store-wal"))
+        var outcome = StoreCompaction.Outcome.failed
+        let took = millis { outcome = StoreCompaction(defaults: UserDefaults(suiteName: "noctis.rc.\(UUID().uuidString)") ?? .standard).compact(url) }
+        #expect(outcome == .compacted)
+        print("COMPACTION-TIMING journal \(bytesBefore / 1024) KB -> \(size(url) / 1024) KB in \(Int(took)) ms")
+        #expect(size(url) < bytesBefore / 2, "\(bytesBefore) -> \(size(url))")
+
+        let reopened = try JournalContainer.make(directory: dir, recovery: recovery(dir, outcomes))
+        let rows = try ModelContext(reopened).fetch(FetchDescriptor<JournalEntry>())
+        #expect(rows.count == kept.count && Set(rows.map(\.text)) == Set(kept), "every kept entry, and only those")
+        #expect(outcomes.all.allSatisfy { $0 == .opened }, "no damaged store was set aside: \(outcomes.all)")
+        #expect(FileFacts(url) == before, "protection and backup exclusion are as they were: \(before) -> \(FileFacts(url))")
+    }
+
+    @Test func coachConversationsAreCompactedAndReadBack() throws {
+        let dir = try folder()
+        defer { try? FileManager.default.removeItem(at: dir) }
+        let url = dir.appending(path: "coach-history.store")
+        let outcomes = Outcomes()
+        var keptIDs: Set<UUID> = []
+        do {
+            let container = try CoachHistoryContainer.make(directory: dir, recovery: recovery(dir, outcomes))
+            let context = ModelContext(container)
+            for _ in 0..<30000 { context.insert(AIConversation()) }
+            try context.save()
+            for (index, conversation) in try context.fetch(FetchDescriptor<AIConversation>()).enumerated() {
+                if index % 10 == 0 { keptIDs.insert(conversation.id) } else { context.delete(conversation) }
+            }
+            try context.save()
+        }
+        let before = FileFacts(url)
+        let bytesBefore = size(url) + size(dir.appending(path: "coach-history.store-wal"))
+        var outcome = StoreCompaction.Outcome.failed
+        let took = millis { outcome = StoreCompaction(defaults: UserDefaults(suiteName: "noctis.rc.\(UUID().uuidString)") ?? .standard).compact(url) }
+        #expect(outcome == .compacted)
+        print("COMPACTION-TIMING coach \(bytesBefore / 1024) KB -> \(size(url) / 1024) KB in \(Int(took)) ms")
+        #expect(size(url) < bytesBefore)
+
+        let reopened = try CoachHistoryContainer.make(directory: dir, recovery: recovery(dir, outcomes))
+        let rows = try ModelContext(reopened).fetch(FetchDescriptor<AIConversation>())
+        #expect(Set(rows.map(\.id)) == keptIDs)
+        #expect(outcomes.all.allSatisfy { $0 == .opened }, "\(outcomes.all)")
+        #expect(FileFacts(url) == before, "\(before) -> \(FileFacts(url))")
+    }
+
+    @Test func theAppDatabaseIsCompactedAndReadBack() throws {
+        let dir = try folder()
+        defer { try? FileManager.default.removeItem(at: dir) }
+        let url = dir.appending(path: "default.store")
+        var keptCount = 0
+        do {
+            let container = try NoctisStore.container(at: url)
+            let context = ModelContext(container)
+            let profile = UserProfileRecord()
+            profile.name = "Kept"
+            context.insert(profile)
+            for index in 0..<40000 {
+                let session = WindDownSession()
+                session.plannedMinutes = index
+                context.insert(session)
+            }
+            try context.save()
+            for session in try context.fetch(FetchDescriptor<WindDownSession>()) {
+                if session.plannedMinutes % 10 == 0 { keptCount += 1 } else { context.delete(session) }
+            }
+            try context.save()
+        }
+        let before = FileFacts(url)
+        let bytesBefore = size(url) + size(dir.appending(path: "default.store-wal"))
+        var outcome = StoreCompaction.Outcome.failed
+        let took = millis { outcome = StoreCompaction(defaults: UserDefaults(suiteName: "noctis.rc.\(UUID().uuidString)") ?? .standard).compact(url) }
+        #expect(outcome == .compacted)
+        print("COMPACTION-TIMING app \(bytesBefore / 1024) KB -> \(size(url) / 1024) KB in \(Int(took)) ms")
+
+        let reopened = try NoctisStore.container(at: url)
+        let context = ModelContext(reopened)
+        #expect(try context.fetchCount(FetchDescriptor<WindDownSession>()) == keptCount)
+        #expect(try context.fetch(FetchDescriptor<UserProfileRecord>()).first?.name == "Kept", "the profile is untouched")
+        #expect(FileFacts(url) == before)
+        // And it still saves.
+        context.insert(WindDownSession())
+        try context.save()
+    }
+
+    @MainActor
+    @Test func notBeingAskedCostsNothingAtLaunch() {
+        let defaults = UserDefaults(suiteName: "noctis.rc.\(UUID().uuidString)") ?? .standard
+        var found: [URL] = []
+        let took = millis { found = DataManager.databaseFiles() }
+        let idle = millis { StoreCompaction(defaults: defaults).runIfRequested(found) }
+        print("COMPACTION-TIMING launch-with-no-request: list \(Int(took * 1000)) us, check \(Int(idle * 1000)) us")
+        #expect(idle < 50, "a launch with no request does one flag read: \(idle) ms")
+    }
+
+    /// The measured evidence for R-04: by default SQLite writes the copy `VACUUM` makes into a temporary file in the app's temporary folder; with
+    /// `temp_store = MEMORY`, which is what `compact` sets, it writes nothing there.
+    @Test func compactionWritesNoTemporaryFileWhereTheDefaultDoes() throws {
+        let dir = try folder()
+        defer { try? FileManager.default.removeItem(at: dir) }
+        func big(_ name: String) throws -> URL {
+            let url = dir.appending(path: name)
+            let container = try ModelContainer(
+                for: JournalEntry.self, configurations: ModelConfiguration(name, url: url, allowsSave: true, cloudKitDatabase: .none))
+            let context = ModelContext(container)
+            for index in 0..<30000 {
+                let entry = JournalEntry()
+                entry.text = "\(index) " + String(repeating: "word ", count: 160)
+                context.insert(entry)
+            }
+            try context.save()
+            return url
+        }
+        let temporary = URL(fileURLWithPath: NSTemporaryDirectory())
+        func sawTemporaryFile(during work: () -> Void) -> Bool {
+            let seen = Seen()
+            let stop = Seen()
+            let poller = Thread {
+                while !stop.flag {
+                    if let names = try? FileManager.default.contentsOfDirectory(atPath: temporary.path), names.contains(where: { $0.hasPrefix("etilqs_") }) { seen.flag = true }
+                }
+            }
+            poller.start()
+            work()
+            stop.flag = true
+            return seen.flag
+        }
+        // Positive control: SQLite's default really does put a file there. The polling can miss it on a busy machine, so the control is tried a few times; if it
+        // is never seen the result for `compact` is inconclusive and is not asserted (the source check below holds the pragma in place either way).
+        var defaultSaw = false
+        for attempt in 0..<5 where !defaultSaw {
+            let control = try big("control\(attempt).store")
+            defaultSaw = sawTemporaryFile(during: { Self.vacuum(control, memory: false) })
+        }
+        let ours = try big("ours.store")
+        let oursSaw = sawTemporaryFile(during: {
+            _ = StoreCompaction(defaults: UserDefaults(suiteName: "noctis.rc.\(UUID().uuidString)") ?? .standard, maximumBytes: 512 * 1_048_576).compact(ours)
+        })
+        print("COMPACTION-TIMING temp-file evidence: default saw=\(defaultSaw) ours saw=\(oursSaw)")
+        if defaultSaw { #expect(!oursSaw, "compact must not write the copy outside the store") }
+        let source = try String(
+            contentsOf: RawDefaultsTests.root.appendingPathComponent("Packages/NoctisKit/Sources/NoctisCore/StoreCompaction.swift"), encoding: .utf8)
+        let pragma = try #require(source.range(of: "PRAGMA temp_store = MEMORY;"))
+        let vacuum = try #require(source.range(of: "VACUUM;"))
+        #expect(pragma.lowerBound < vacuum.lowerBound, "the copy is kept in memory before the VACUUM runs")
+    }
+
+    private nonisolated final class Seen: @unchecked Sendable {
+        private let lock = NSLock()
+        private var value = false
+        var flag: Bool {
+            get { lock.withLock { value } }
+            set { lock.withLock { value = newValue } }
+        }
+    }
+
+    private static func vacuum(_ url: URL, memory: Bool) {
+        var database: OpaquePointer?
+        guard sqlite3_open_v2(url.path, &database, SQLITE_OPEN_READWRITE, nil) == SQLITE_OK else { return }
+        defer { sqlite3_close(database) }
+        if memory { sqlite3_exec(database, "PRAGMA temp_store = MEMORY;", nil, nil, nil) }
+        sqlite3_exec(database, "PRAGMA wal_checkpoint(TRUNCATE);", nil, nil, nil)
+        sqlite3_exec(database, "VACUUM;", nil, nil, nil)
+    }
+}
diff --git a/Packages/NoctisKit/Tests/NoctisKitTests/StoreCompactionTests.swift b/Packages/NoctisKit/Tests/NoctisKitTests/StoreCompactionTests.swift
new file mode 100644
index 0000000..2c3b66d
--- /dev/null
+++ b/Packages/NoctisKit/Tests/NoctisKitTests/StoreCompactionTests.swift
@@ -0,0 +1,164 @@
+import Foundation
+import SQLite3
+import Testing
+
+@testable import NoctisCore
+
+// Rows deleted from a database leave free pages until the file is compacted (S1B-B03). The next launch compacts, once, carefully, before anything opens it.
+
+private func makeDatabase(rows: Int = 400, deleting: Bool = true) throws -> URL {
+    let url = URL.temporaryDirectory.appending(path: "noctis-compact-\(UUID().uuidString).store", directoryHint: .notDirectory)
+    var db: OpaquePointer?
+    #expect(sqlite3_open(url.path, &db) == SQLITE_OK)
+    defer { sqlite3_close(db) }
+    sqlite3_exec(db, "PRAGMA journal_mode=WAL;", nil, nil, nil)
+    sqlite3_exec(db, "CREATE TABLE entry (id INTEGER PRIMARY KEY, body TEXT);", nil, nil, nil)
+    sqlite3_exec(db, "BEGIN;", nil, nil, nil)
+    for index in 0..<rows { sqlite3_exec(db, "INSERT INTO entry (body) VALUES ('\(String(repeating: "x", count: 900))-\(index)');", nil, nil, nil) }
+    sqlite3_exec(db, "COMMIT;", nil, nil, nil)
+    if deleting { sqlite3_exec(db, "DELETE FROM entry WHERE id % 10 <> 0;", nil, nil, nil) }
+    sqlite3_exec(db, "PRAGMA wal_checkpoint(TRUNCATE);", nil, nil, nil)
+    return url
+}
+
+private func rowCount(_ url: URL) -> Int {
+    var db: OpaquePointer?
+    guard sqlite3_open_v2(url.path, &db, SQLITE_OPEN_READONLY, nil) == SQLITE_OK else { return -1 }
+    defer { sqlite3_close(db) }
+    var statement: OpaquePointer?
+    sqlite3_prepare_v2(db, "SELECT COUNT(*) FROM entry;", -1, &statement, nil)
+    defer { sqlite3_finalize(statement) }
+    return sqlite3_step(statement) == SQLITE_ROW ? Int(sqlite3_column_int(statement, 0)) : -1
+}
+
+private func size(_ url: URL) -> Int { (try? FileManager.default.attributesOfItem(atPath: url.path)[.size] as? Int) ?? 0 }
+
+private func defaults() -> UserDefaults { UserDefaults(suiteName: "noctis.compact.\(UUID().uuidString)") ?? .standard }
+
+struct StoreCompactionTests {
+    @Test func compactingGivesTheFreedPagesBackAndKeepsEveryRemainingRow() throws {
+        let url = try makeDatabase()
+        defer { try? FileManager.default.removeItem(at: url) }
+        let before = size(url)
+        #expect(rowCount(url) == 40)
+        #expect(StoreCompaction(defaults: defaults()).compact(url) == .compacted)
+        #expect(size(url) < before / 2, "\(before) -> \(size(url))")
+        #expect(rowCount(url) == 40, "what was kept is kept")
+    }
+
+    @Test func aMissingFileIsNothingToDo() {
+        let url = URL.temporaryDirectory.appending(path: "noctis-none-\(UUID().uuidString).store")
+        #expect(StoreCompaction(defaults: defaults()).compact(url) == .missing)
+    }
+
+    @Test func aDamagedFileIsLeftExactlyAsItIsForTheRecoveryToSetAside() throws {
+        let url = URL.temporaryDirectory.appending(path: "noctis-bad-\(UUID().uuidString).store")
+        try Data(repeating: 0x41, count: 8192).write(to: url)
+        defer { try? FileManager.default.removeItem(at: url) }
+        let bytes = try Data(contentsOf: url)
+        #expect(StoreCompaction(defaults: defaults()).compact(url) == .notIntact)
+        #expect(try Data(contentsOf: url) == bytes, "not a byte changed")
+    }
+
+    @Test func aLargeFileIsLeftAlone() throws {
+        let url = try makeDatabase()
+        defer { try? FileManager.default.removeItem(at: url) }
+        let before = size(url)
+        #expect(StoreCompaction(defaults: defaults(), maximumBytes: 1_000).compact(url) == .tooLarge)
+        #expect(size(url) == before && rowCount(url) == 40)
+        #expect(StoreCompaction.maximumBytes == 16 * 1_048_576)
+    }
+
+    @Test func aFileThatCannotBeOpenedForWritingWaitsForTheNextLaunch() throws {
+        let url = try makeDatabase()
+        defer { try? FileManager.default.removeItem(at: url) }
+        let busy = StoreCompaction(defaults: defaults())
+        // A connection that holds the write lock, as a running app's would.
+        var holder: OpaquePointer?
+        #expect(sqlite3_open(url.path, &holder) == SQLITE_OK)
+        defer { sqlite3_close(holder) }
+        sqlite3_exec(holder, "BEGIN EXCLUSIVE;", nil, nil, nil)
+        let outcome = busy.compact(url)
+        sqlite3_exec(holder, "ROLLBACK;", nil, nil, nil)
+        #expect(outcome == .unavailable || outcome == .failed, "\(outcome)")
+        #expect(rowCount(url) == 40)
+    }
+}
+
+struct StoreCompactionRequestTests {
+    @Test func nothingRunsUnlessADeletionAsked() throws {
+        let url = try makeDatabase()
+        defer { try? FileManager.default.removeItem(at: url) }
+        let before = size(url)
+        let compaction = StoreCompaction(defaults: defaults())
+        #expect(!compaction.isPending && compaction.runIfRequested([url]).isEmpty)
+        #expect(size(url) == before, "no request, no work")
+    }
+
+    @Test func aRequestRunsOnceAndIsClearedWhenEveryDatabaseWasDealtWith() throws {
+        let url = try makeDatabase()
+        defer { try? FileManager.default.removeItem(at: url) }
+        let compaction = StoreCompaction(defaults: defaults())
+        compaction.request()
+        let missing = URL.temporaryDirectory.appending(path: "noctis-none-\(UUID().uuidString).store")
+        let outcomes = compaction.runIfRequested([url, missing])
+        #expect(outcomes.map(\.1) == [.compacted, .missing])
+        #expect(!compaction.isPending, "once per request")
+        #expect(compaction.runIfRequested([url]).isEmpty)
+    }
+
+    @Test func aRequestThatCouldNotRunWaitsForTheNextLaunch() throws {
+        let url = try makeDatabase()
+        defer { try? FileManager.default.removeItem(at: url) }
+        let defaults = defaults()
+        StoreCompaction(defaults: defaults).request()
+        // A connection that holds the write lock, as a running app's would.
+        var holder: OpaquePointer?
+        #expect(sqlite3_open(url.path, &holder) == SQLITE_OK)
+        sqlite3_exec(holder, "BEGIN EXCLUSIVE;", nil, nil, nil)
+        let blocked = StoreCompaction(defaults: defaults).runIfRequested([url]).map(\.1)
+        sqlite3_exec(holder, "ROLLBACK;", nil, nil, nil)
+        sqlite3_close(holder)
