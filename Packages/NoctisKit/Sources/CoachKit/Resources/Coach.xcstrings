    },
    "coach.script.medical": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't diagnose or assess health conditions. If something about your sleep or health worries you, a doctor is the right person to ask. I can explain patterns in your data."
          }
        }
      }
    },
