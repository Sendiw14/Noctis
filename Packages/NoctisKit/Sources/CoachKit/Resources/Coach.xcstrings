    "coach.router.bedtimeAdvice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\bwhen should i (sleep|go to (bed|sleep)|turn in|be in bed|get to bed)\\b\n\\bwhat time should i (sleep|go to (bed|sleep)|turn in|be in bed)\\b\n\\b(best|ideal|good|right|target|optimal) (bed ?time|time to (sleep|go to bed))\\b\n\\bwhen to (sleep|go to bed)\\b\n\\bbed ?time (tonight|advice|suggestion|recommendation)\\b\n\\bwhat time (tonight|to sleep|to go to bed)\\b\n\\bshould i (sleep|go to bed) (earlier|later|now|tonight)\\b"
          }
        }
      }
    },
