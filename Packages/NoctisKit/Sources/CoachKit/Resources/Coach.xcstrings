    "coach.script.crisis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're not alone, and how you feel matters. If you might act on thoughts of harming yourself, please contact your local emergency services now. Reaching out to someone you trust can help too, and a helpline can talk with you at any hour."
          }
