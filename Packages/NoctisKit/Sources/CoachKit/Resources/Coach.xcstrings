    },
    "coach.router.crisis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\bkill(ing)? myself\\b\n\\bend(ing)? (my|my own) life\\b\n\\bend it all\\b\n\\bwant(ed)? to die\\b\n\\bwish i (was|were) (dead|gone)\\b\n\\bsuicid\\w*\n\\bself ?harm\\w*\n\\b(hurt|hurting|harm|harming|cut|cutting) myself\\b\n\\bdont want to (live|be here|exist|wake up|go on)\\b\n\\bno reason to live\\b\n\\bbetter off (dead|without me)\\b\n\\btake my (own )?life\\b\n\\b(not|isnt) worth living\\b\n\\blife (is not|isnt) worth\\b\n\\bcant go on (like this|anymore|any more)\\b\n\\b(tired|sick) of (living|being alive|life)\\b\n\\bdont want to be alive\\b\n\\bkill me\\b\n\\bend my (suffering|pain)\\b\n\\boverdos\\w*"
          }
        }
      }
    },
