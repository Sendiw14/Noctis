diff --git a/Packages/NoctisKit/Sources/AppRoot/PrivacyShield.swift b/Packages/NoctisKit/Sources/AppRoot/PrivacyShield.swift
new file mode 100644
index 0000000..faaf4d3
--- /dev/null
+++ b/Packages/NoctisKit/Sources/AppRoot/PrivacyShield.swift
@@ -0,0 +1,116 @@
+import DesignSystem
+import SwiftUI
+import UIKit
+
+// What the app switcher may show (Stage 1A, audit SEC-05). iOS keeps a picture of the app's last screen for the app switcher, and it was a recovery score,
+// last night's sleep or a Journal entry. While the app is not the active scene a plain screen covers everything, sheets included, and it goes the moment
+// the scene is active again. Nothing underneath is touched: no view is rebuilt, no navigation resets, and alarms, audio, notifications, Live Activities
+// and the Watch link never see it.
+//
+// It is a second window above the app's own (the way the system puts its alerts above an app), not a blur and not a screenshot trick: a SwiftUI overlay on
+// the root view would leave a presented sheet visible, and a sheet is where the Journal opens. The window is not made key, so it takes no focus from the
+// app, and it is thrown away on every return, so it keeps nothing.
+
+/// Puts a cover over a scene, and takes it away.
+@MainActor
+public protocol PrivacyShieldPresenting: AnyObject {
+    /// Covers `scene`, or every connected window scene when it is nil.
+    func show(over scene: UIWindowScene?)
+    func hide(over scene: UIWindowScene?)
+}
+
+/// Watches the scene's activity and asks the presenter to cover or uncover.
+@MainActor
+public final class PrivacyShield {
+    /// The one the app uses.
+    public static let shared = PrivacyShield()
+
+    public private(set) var isCovering = false
+
+    private let presenter: any PrivacyShieldPresenting
+    private let center: NotificationCenter
+    private var observers: [any NSObjectProtocol] = []
+
+    public init(presenter: any PrivacyShieldPresenting = WindowShieldPresenter(), center: NotificationCenter = .default) {
+        self.presenter = presenter
+        self.center = center
+    }
+
+    /// Starts watching. A second call does nothing.
+    public func start() {
+        guard observers.isEmpty else { return }
+        // `willDeactivate` comes before the system takes the app switcher's picture; `didActivate` is the return to the front.
+        observers = [
+            center.addObserver(forName: UIScene.willDeactivateNotification, object: nil, queue: .main) { [weak self] note in
+                let scene = note.object as? UIWindowScene
+                MainActor.assumeIsolated { self?.cover(scene) }
+            },
+            center.addObserver(forName: UIScene.didActivateNotification, object: nil, queue: .main) { [weak self] note in
+                let scene = note.object as? UIWindowScene
+                MainActor.assumeIsolated { self?.uncover(scene) }
+            },
+        ]
+    }
+
+    func cover(_ scene: UIWindowScene?) {
+        isCovering = true
+        presenter.show(over: scene)
+    }
+
+    func uncover(_ scene: UIWindowScene?) {
+        isCovering = false
+        presenter.hide(over: scene)
+    }
+}
+
+/// The real cover: one hidden-by-default window per scene, above every other window.
+@MainActor
+public final class WindowShieldPresenter: PrivacyShieldPresenting {
+    private var windows: [ObjectIdentifier: UIWindow] = [:]
+
+    public init() {}
+
+    public func show(over scene: UIWindowScene?) {
+        for target in targets(scene) where windows[ObjectIdentifier(target)] == nil {
+            let window = UIWindow(windowScene: target)
+            // Above the app's windows, its sheets and the system's own alerts raised by the app.
+            window.windowLevel = .alert + 1
+            let host = UIHostingController(rootView: PrivacyShieldView())
+            host.view.backgroundColor = .clear
+            window.rootViewController = host
+            window.isHidden = false
+            windows[ObjectIdentifier(target)] = window
+        }
+    }
+
+    public func hide(over scene: UIWindowScene?) {
+        for target in targets(scene) {
+            guard let window = windows.removeValue(forKey: ObjectIdentifier(target)) else { continue }
+            window.isHidden = true
+            window.rootViewController = nil
+        }
+        // With no scene named, nothing may stay up: a window of a scene that has gone away is hidden too.
+        if scene == nil {
+            for window in windows.values { window.isHidden = true }
+            windows.removeAll()
+        }
+    }
+
+    private func targets(_ scene: UIWindowScene?) -> [UIWindowScene] {
+        if let scene { return [scene] }
+        return UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
+    }
+}
+
+/// What the cover shows: the app's own background and one quiet symbol. No number, no name, no text, and nothing read from the app's data.
+struct PrivacyShieldView: View {
+    var body: some View {
+        ZStack {
+            NoctisAppColor.bg.ignoresSafeArea()
+            Image(systemName: "moon.stars.fill")
+                .font(.system(size: 44, weight: .regular))
+                .foregroundStyle(NoctisAppColor.ink3)
+                .accessibilityHidden(true)
+        }
+    }
+}
diff --git a/Packages/NoctisKit/Tests/NoctisKitTests/ExportProtectionTests.swift b/Packages/NoctisKit/Tests/NoctisKitTests/ExportProtectionTests.swift
new file mode 100644
index 0000000..77fe35b
--- /dev/null
+++ b/Packages/NoctisKit/Tests/NoctisKitTests/ExportProtectionTests.swift
@@ -0,0 +1,109 @@
+import Foundation
+import Testing
+
+@testable import NoctisCore
+
+// Stage 1A, audit SEC-03: "Export my data" wrote the file atomically but with the default protection class, while the Journal and Coach files that the
+// export copies are complete-while-locked. The export holds the same text, so it gets the same class, still written whole-or-not-at-all, and every
+// cleanup removes it and any partial file a cut-short write could leave.
+@MainActor
+struct ExportProtectionTests {
+    private func folder() throws -> URL {
+        let url = URL.temporaryDirectory.appending(path: "noctis-export-\(UUID().uuidString)", directoryHint: .isDirectory)
+        try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        return url
+    }
+
+    private func names(in directory: URL) -> [String] {
+        ((try? FileManager.default.contentsOfDirectory(atPath: directory.path)) ?? []).sorted()
+    }
+
+    // MARK: Protection
+
+    @Test func theExportFileHasCompleteProtectionWhereThePlatformReportsOne() async throws {
+        let bench = try DataBench()
+        bench.wire()
+        let url = try await bench.manager.exportFile()
+        defer { bench.manager.discardExport() }
+        // The simulator reports no class for a file; a device does. Where one is reported it must be the strong one.
+        if let protection = try FileManager.default.attributesOfItem(atPath: url.path)[.protectionKey] as? FileProtectionType {
+            #expect(protection == .complete)
+        }
+    }
+
+    @Test func theCodeAsksForCompleteProtectionAndKeepsTheWholeOrNothingWrite() throws {
+        let text = try String(
+            contentsOf: RawDefaultsTests.root.appendingPathComponent("Packages/NoctisKit/Sources/NoctisCore/DataExport.swift"), encoding: .utf8)
+        let code = RawDefaultsTests.code(text)
+        #expect(code.contains("options: [.completeFileProtection]"), "the simulator reports no class, so the request itself is held to the code")
+        #expect(!code.contains("UntilFirstUserAuthentication"), "not the weaker class")
+        #expect(code.contains("replaceItemAt") && code.contains("moveItem(at: partial"), "the final file appears by rename: whole or absent")
+        let manager = try String(
+            contentsOf: RawDefaultsTests.root.appendingPathComponent("Packages/NoctisKit/Sources/NoctisCore/DataManager.swift"), encoding: .utf8)
+        #expect(RawDefaultsTests.code(manager).contains("DataExport.write(data, in:"), "the manager has no write of its own to forget the class")
+    }
+
+    // MARK: Whole or absent, and cleanup
+
+    @Test func aSecondExportReplacesTheFirstAndLeavesOnlyTheFinalFile() async throws {
+        let bench = try DataBench()
+        bench.wire()
+        let temporary = bench.roots.url(.temporary)
+        _ = try await bench.manager.exportFile()
+        let url = try await bench.manager.exportFile()
+        defer { bench.manager.discardExport() }
+        #expect(names(in: temporary) == [DataExport.fileName], "no partial file and no stray copy")
+        #expect(try JSONSerialization.jsonObject(with: Data(contentsOf: url)) is [String: Any])
+    }
+
+    @Test func aWriteThatFailsThrowsAndLeavesNothingBehind() throws {
+        let directory = try folder()
+        defer {
+            try? FileManager.default.setAttributes([.posixPermissions: 0o700], ofItemAtPath: directory.path)
+            try? FileManager.default.removeItem(at: directory)
+        }
+        try FileManager.default.setAttributes([.posixPermissions: 0o500], ofItemAtPath: directory.path)
+        #expect(throws: (any Error).self) { try DataExport.write(Data("{}".utf8), in: directory) }
+        #expect(names(in: directory).isEmpty, "a failed export leaves no partial file")
+    }
+
+    @Test func aWriteThatWorksLeavesTheFileAndNoPartialOne() throws {
+        let directory = try folder()
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let url = try DataExport.write(Data("{\"a\":1}".utf8), in: directory)
+        #expect(names(in: directory) == [DataExport.fileName])
+        #expect(try Data(contentsOf: url) == Data("{\"a\":1}".utf8))
+    }
+
+    @Test func aPartialFileLeftByACutShortWriteIsRemovedByDiscardAndWhenTheAppStarts() throws {
+        let bench = try DataBench()
+        let temporary = bench.roots.url(.temporary)
+        let partial = temporary.appending(path: DataExport.partialFileName, directoryHint: .notDirectory)
+        try Data("{".utf8).write(to: partial)
+        bench.wire()
+        #expect(!FileManager.default.fileExists(atPath: partial.path), "the manager clears it when it is made, as it does a finished export")
+
+        try Data("{".utf8).write(to: partial)
+        try Data("{}".utf8).write(to: temporary.appending(path: DataExport.fileName, directoryHint: .notDirectory))
+        bench.manager.discardExport()
+        #expect(names(in: temporary).isEmpty, "Share is done: both names are gone")
+    }
+
+    @Test func deletingEverythingAlsoRemovesAPartialExport() throws {
+        let text = try String(
+            contentsOf: RawDefaultsTests.root.appendingPathComponent("Packages/NoctisKit/Sources/AppRoot/DataWiring.swift"), encoding: .utf8)
+        #expect(RawDefaultsTests.code(text).contains("DataExport.remove(in: i.roots.url(.temporary))"))
+    }
+
+    @Test func theExportCreatesNoCopyOfTheJournalOutsideTheOneFile() async throws {
+        let bench = try DataBench()
+        bench.wire()
+        try await bench.fill()
+        let before = names(in: bench.root)
+        _ = try await bench.manager.exportFile()
+        #expect(names(in: bench.roots.url(.temporary)) == [DataExport.fileName])
+        bench.manager.discardExport()
+        #expect(names(in: bench.roots.url(.temporary)).isEmpty)
+        #expect(names(in: bench.root) == before, "nothing else was written anywhere beside the temporary folder")
+    }
+}
